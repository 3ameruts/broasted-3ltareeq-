{
  "name": "broasted-online-order-reel",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "sound": "bash audio/get_mixkit.sh && python3 audio/mix.py && ffmpeg -y -i audio/out/effects.wav -af loudnorm=I=-15:TP=-1.5:LRA=11 -ar 48000 public/audio.wav",
    "render": "remotion render src/index.ts Reel out/online-order-reel.mp4",
    "capture": "node capture/site.cjs && node capture/branch.cjs"
  },
  "dependencies": {
    "@fontsource/cairo": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "@remotion/cli": "4.0.539",
    "gsap": "3.15.0",
    "lucide-react": "1.66.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
